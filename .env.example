# Get a key at https://console.anthropic.com/
# Required only if you want TRUE AI-generated questions every test.
# Without it, the app still works fully using the built-in practice bank.
ANTHROPIC_API_KEY=

# --- Admin panel (bulk-add questions from a JSON file) ---
# Visit yoursite.com/?admin=1 to use it. See README.md for full setup.
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main
