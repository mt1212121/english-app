# Get a key at https://console.anthropic.com/
# Required only if you want TRUE AI-generated questions every test.
# Without it, the app still works fully using the built-in practice bank.
ANTHROPIC_API_KEY=

# --- Admin panel (bulk-add questions from a JSON file) ---
# Visit yoursite.com/?admin=1 to use it. See README.md for full setup.
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main

# --- Supabase (user accounts & test results sync) ---
# Get these from https://app.supabase.com → Project Settings → API
# Without these, the app still works fully using localStorage only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Service Role Key (admin functions only) ---
# Required for admin-users endpoint to access all user data.
# NEVER expose this key to the client - only use in Netlify Functions.
SUPABASE_SERVICE_ROLE_KEY=
